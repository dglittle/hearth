# hearth is the SEED, not a running agent. Everything below is per-agent
# living state or secrets: it belongs in the agent's working copy, never here.

# --- per-host config (describes your machine; see host.conf.example) ---
host.conf

# --- secrets (never, ever) ---
secrets/
*.env
.env*
web/key.txt
*.pem

# --- living state ---
*.log
ergs.jsonl
ergs/
db/cards.db
db/cards.db-wal
db/cards.db-shm
tok-pref.json
web/limits.json
web/settings.json
imgs/
tmp/
work/
output/

# --- domain data: whatever feeds this agent's board (collectors, cursors,
#     fetched events) belongs to her employer, not to the seed ---
stream/

# --- junk ---
*.bak
*.bak-*
node_modules/
.DS_Store
